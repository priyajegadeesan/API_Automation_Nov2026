# Environment Configuration Template
# Copy this file to .env.prod or .env.uat and fill in actual values
# NEVER commit files with real credentials!

# Environment name
ENV=prod

# API Configuration
BASE_URL=https://your-api-endpoint.com/api
CUSTOMER_ID=your_customer_id_here

# Authentication - REPLACE WITH YOUR ACTUAL TOKENS
# Get your tokens from the Opsera platform
BEARER_TOKEN=your_bearer_token_here
SCIM_BEARER_TOKEN=your_scim_bearer_token_here
AUTH_TOKEN=your_auth_token_here
API_KEY=your_api_key_here

# RBAC Testing (optional)
RBAC_USER_TOKEN=your_rbac_token_here

# Test Configuration
API_TIMEOUT=45000
PARALLEL_WORKERS=1
RETRIES=0

# Logging
LOG_LEVEL=info
