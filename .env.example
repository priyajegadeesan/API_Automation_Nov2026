# Environment Selection
# Options: uat, test, prod
ENV=test

# API Configuration (will be overridden by environment-specific settings)
BASE_URL=https://api.opsera-test.opsera.io/api
CUSTOMER_ID=6389f1a83527c100737ece11
API_TIMEOUT=30000

# Authentication
API_KEY=your_api_key_here
AUTH_TOKEN=your_auth_token_here
BEARER_TOKEN=your_bearer_token_here

# Test Configuration
PARALLEL_WORKERS=2
RETRIES=2

# Logging
LOG_LEVEL=info

# Environment-Specific Files:
# Copy .env.uat, .env.test, or .env.prod to .env based on your needs
# Or set ENV variable to switch between environments
