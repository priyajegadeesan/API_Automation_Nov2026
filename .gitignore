node_modules/
dist/
reports/
logs/

# ============================================
# SECURITY: Environment Files
# ============================================
# NEVER commit files with real credentials!
# Only .env.example should be committed

# All .env files (except .example)
.env
.env.local
.env.*.local
.env.uat
.env.prod
.env.test
.env.development
.env.staging

# Environment backups
.env*.backup
*.env.backup

# Keep only these template files (committed):
# - .env.example (placeholder values only)

# ============================================
# SECURITY: Secrets & Credentials
# ============================================
*secret*
*credentials*
*password*
*token.txt
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer

# ============================================
# Build & Dependencies
# ============================================
package-lock.json
yarn.lock
pnpm-lock.yaml

# ============================================
# Test Results & Reports
# ============================================
playwright-report/
test-results/
coverage/
.nyc_output/

# ============================================
# Logs
# ============================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# ============================================
# OS Files
# ============================================
.DS_Store
Thumbs.db
desktop.ini

# ============================================
# IDE & Editor Files
# ============================================
.idea/
.vscode/
*.swp
*.swo
*.swn
*~
.project
.classpath
.settings/

