#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🔒 Running pre-commit security checks..."

# Check for environment files with real credentials
if git diff --cached --name-only | grep -E '\.env\.(uat|prod|test)$'; then
  echo "❌ ERROR: Attempting to commit real environment files!"
  echo "   Only .env.example and .env.*.template files should be committed."
  echo "   Real .env files contain secrets and should never be committed."
  exit 1
fi

# Check for common secret files
if git diff --cached --name-only | grep -E '\.(pem|key|p12|pfx|keystore)$'; then
  echo "❌ ERROR: Attempting to commit private key files!"
  echo "   Private keys (.pem, .key, etc.) should never be committed."
  exit 1
fi

# Run secret scanner on staged files
node scripts/scan-secrets.js

if [ $? -ne 0 ]; then
  echo "❌ Secret scan failed! Review the findings above."
  echo "   Move secrets to .env files and use environment variables."
  exit 1
fi

echo "✅ Pre-commit checks passed!"
exit 0
