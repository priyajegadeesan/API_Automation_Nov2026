# PROD Environment Configuration Template
# Copy this file to .env.prod and replace with actual values
# WARNING: Use PROD credentials with extreme caution!

ENV=prod
BASE_URL=https://app.opsera.io/api
CUSTOMER_ID=your_prod_customer_id_here
API_TIMEOUT=45000

# Authentication Tokens
# Generate these tokens from your Opsera PROD dashboard
BEARER_TOKEN=your_prod_admin_bearer_token_here
SCIM_BEARER_TOKEN=your_prod_scim_bearer_token_here
RBAC_USER_TOKEN=your_prod_rbac_user_token_here

# Test Configuration
PARALLEL_WORKERS=1
RETRIES=2

# Logging
LOG_LEVEL=info
