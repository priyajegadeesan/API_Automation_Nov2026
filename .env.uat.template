# UAT Environment Configuration Template
# Copy this file to .env.uat and replace with actual values

ENV=uat
BASE_URL=https://api.opsera-uat.opsera.io/api
CUSTOMER_ID=your_uat_customer_id_here
API_TIMEOUT=120000

# Authentication Tokens
# Generate these tokens from your Opsera UAT dashboard
BEARER_TOKEN=your_uat_admin_bearer_token_here
SCIM_BEARER_TOKEN=your_uat_scim_bearer_token_here
RBAC_USER_TOKEN=your_uat_rbac_user_token_here

# Test Configuration
PARALLEL_WORKERS=1
RETRIES=2

# Logging
LOG_LEVEL=info
